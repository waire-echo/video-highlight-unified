{
  "json": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "video_summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      },
      "semantic_segments": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "start": {
              "type": "number"
            },
            "end": {
              "type": "number"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "change_from_previous": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "id",
            "start",
            "end",
            "description",
            "change_from_previous"
          ]
        }
      },
      "highlight_candidates": {
        "type": "array",
        "minItems": 2,
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "segment_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              }
            },
            "start": {
              "type": "number"
            },
            "end": {
              "type": "number"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "context_before": {
              "type": "string",
              "maxLength": 200
            },
            "event_progression": {
              "type": "string",
              "maxLength": 240
            }
          },
          "required": [
            "id",
            "segment_ids",
            "start",
            "end",
            "description",
            "context_before",
            "event_progression"
          ]
        }
      }
    },
    "required": [
      "video_summary",
      "semantic_segments",
      "highlight_candidates"
    ]
  },
  "disable_any_whitespace": true
}
